# CanaryGuard Environment Configuration Example
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=canaryguard_secure_secret_key_change_in_production
DATABASE_URL=sqlite:///database/canaryguard.db

# Engine Default Settings
DEFAULT_ENTROPY_THRESHOLD=7.2
AUTO_QUARANTINE_ENABLED=true
MAX_FILE_BURST_COUNT=10
BURST_TIME_WINDOW_SECONDS=3
MONITORED_DIRECTORIES=./monitored_test
LOG_LEVEL=INFO
